# Copy to private .env and choose your own access key. Never commit real secrets.
OPTIMUS_ACCESS_KEY=
OPTIMUS_PUBLIC_API_KEY=
# Optional existing provider integrations. Local invoice extraction needs no model key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
# Optional OCR overrides; leave unset for normal Tesseract installations.
MYDATA_TESSERACT_PATH=
MYDATA_TESSDATA_DIR=

# Optional read-only AADE connections. Choose a slot in each company profile.
# VAT_NUMBER is the API credential owner, not the represented company.
# Test and production credentials are independent; no fallback is used.
MYDATA_SLOT_1_PROD_USER_ID=
MYDATA_SLOT_1_PROD_SUBSCRIPTION_KEY=
MYDATA_SLOT_1_PROD_VAT_NUMBER=
MYDATA_SLOT_1_TEST_USER_ID=
MYDATA_SLOT_1_TEST_SUBSCRIPTION_KEY=
MYDATA_SLOT_1_TEST_VAT_NUMBER=
MYDATA_SLOT_2_PROD_USER_ID=
MYDATA_SLOT_2_PROD_SUBSCRIPTION_KEY=
MYDATA_SLOT_2_PROD_VAT_NUMBER=
MYDATA_SLOT_2_TEST_USER_ID=
MYDATA_SLOT_2_TEST_SUBSCRIPTION_KEY=
MYDATA_SLOT_2_TEST_VAT_NUMBER=
MYDATA_SLOT_3_PROD_USER_ID=
MYDATA_SLOT_3_PROD_SUBSCRIPTION_KEY=
MYDATA_SLOT_3_PROD_VAT_NUMBER=
MYDATA_SLOT_3_TEST_USER_ID=
MYDATA_SLOT_3_TEST_SUBSCRIPTION_KEY=
MYDATA_SLOT_3_TEST_VAT_NUMBER=
